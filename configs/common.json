{
  "schema_version": "1.0",
  "config_id": "muma-tom-common-v1",
  "profile_type": "frozen_reproducibility_protocol",
  "configuration_origin": "manuscript_aligned_release_configuration",
  "dataset": {
    "name": "MuMA-ToM",
    "episodes": 225,
    "raw_videos": 1030,
    "questions": 900,
    "question_types": ["belief", "social-goal", "goal-belief"],
    "questions_per_type": 300,
    "question_key": ["episode_id", "question_id"]
  },
  "seeds": {
    "main_question_split": 73194217,
    "episode_disjoint_split": 18465031,
    "repeated_run_subset": 59280463,
    "human_reference_subset": 31847029,
    "paired_bootstrap": 84726111,
    "non_debate_api": 90472131,
    "run_seeds": [35719823, 68245109, 11472863, 94026571, 52680347]
  },
  "models": {
    "visual_parser": "gemini-2.5-pro-preview-05-06",
    "default_core_reasoner": "gpt-4o-2024-11-20",
    "backbone_comparison": [
      "gpt-5",
      "gpt-4o-2024-11-20",
      "DeepSeek-V3.1",
      "Qwen3-VL-32B-Instruct",
      "Meta-Llama-3.2-90B-Vision-Instruct"
    ],
    "budget_cost_and_repeated_runs": "gpt-3.5-turbo-0125",
    "confidence_consistency_baselines": ["gpt-4o-2024-11-20", "o4-mini", "gemini-2.5-flash"],
    "api_style": "OpenAI-compatible"
  },
  "decoding": {
    "non_debate_temperature": 0.0,
    "debate_agent_temperature": 0.3,
    "synthesizer_temperature": 0.1,
    "max_tokens": 1000,
    "non_debate_seed": 90472131,
    "debate_seed": "run_seed",
    "synthesizer_seed": "run_seed_plus_2",
    "role_seed_precedence": "model_routing_route_seed_overrides_generic_decoding_role_seed",
    "unsupported_seed_policy": "record_seed_unsupported_in_run_manifest",
    "request_timeout_seconds": 120,
    "max_retries": 3,
    "retry_backoff_seconds": [2, 4, 8],
    "concurrency": 1,
    "cache": "disabled_for_reported_runs"
  },
  "prompts": {
    "directory": "../prompts",
    "manifest": "../prompts/prompt_manifest.json",
    "person_action_utterance_parsing": "person_action_utterance_parsing.txt",
    "initial_state_extraction": "initial_state_extraction.txt",
    "latent_hypothesis_generation": "latent_hypothesis_generation.txt",
    "visual_action_extraction": "visual_action_extraction.txt",
    "visual_request": "visual_request_user_message.txt",
    "utterance_likelihood": "utterance_likelihood.txt",
    "action_likelihood": "action_likelihood.txt",
    "bounded_score_fallback": "bounded_score_fallback.txt",
    "question_type_classification": "question_type_classification.txt",
    "short_context_summary": "short_context_summary.txt",
    "logical_agent": "logical_agent.txt",
    "innovative_agent": "innovative_agent.txt",
    "synthesizer_agent": "synthesizer_agent.txt",
    "debate_round_user_message": "debate_round_user_message.txt",
    "synthesizer_user_message": "synthesizer_user_message.txt",
    "reasoning_summary": "reasoning_summary.txt",
    "retrieval_pattern_summary": "retrieval_pattern_summary.txt",
    "invalid_format_repair": "invalid_format_repair.txt"
  },
  "option_scoring": {
    "hypothesis_prior": "1/M",
    "binary_labels": {"likely": "A", "unlikely": "B"},
    "token_logprob_formula": "exp(logp_likely-logsumexp(logp_likely,logp_unlikely))",
    "fallback_score_range": [0.0, 1.0],
    "fallback_score_use": "relative_option_ranking_only",
    "clip_probability": [0.000001, 0.999999],
    "step_accumulation": "log_space",
    "option_normalization": "softmax_with_logsumexp",
    "invalid_binary_response": "retry_then_use_bounded_score_fallback"
  },
  "memory": {
    "partitions": ["belief", "social-goal", "goal-belief"],
    "initialization_source": "memory_split_only",
    "embedding": {
      "method": "deterministic_signed_feature_hashing",
      "dimension": 1536,
      "fields": ["question", "options", "short_context_summary"],
      "lowercase": true,
      "tokenizer_regex": "(?u)\\b\\w+\\b",
      "ngrams": [1, 2],
      "hash_function": "SHA-256",
      "hash_seed": 63841277,
      "index_bytes": "digest[0:8]_big_endian_mod_1536",
      "sign_rule": "positive_if_digest_byte_8_is_even_else_negative",
      "normalization": "L2",
      "similarity": "cosine",
      "zero_vector_similarity": 0.0,
      "similarity_tie_break": ["episode_id_ascending", "question_id_ascending"]
    },
    "capacity_per_partition": 500,
    "trigger_retrieval_k": 5,
    "difficulty_retrieval_k": 5,
    "guidance_candidate_scan_limit": 15,
    "guidance_case_limit": 3,
    "guidance_filter": "correct == true and validity_score > 0.7",
    "entry_fields": [
      "memory_id",
      "episode_id",
      "question_id",
      "question_type",
      "question",
      "options",
      "short_context_summary",
      "ground_truth",
      "baseline_option_distribution",
      "trigger_decision",
      "difficulty_score",
      "difficulty_level",
      "maximum_rounds",
      "actual_rounds",
      "final_answer",
      "correct",
      "reasoning_summary",
      "validity_score",
      "access_count",
      "last_access_utc"
    ],
    "memory_id_format": "{question_type}:{episode_id}:{question_id}",
    "new_entry_validity": {"correct": 0.9, "incorrect": 0.3},
    "validity_update": {"useful": "min(1.0,e+0.1)", "not_useful": "max(0.1,e-0.05)"},
    "pruning_score": "0.5*e+0.3*log(1+access_count)-0.2*log(1+age_days)",
    "age_clock": "UTC_midnight_frozen_at_run_start",
    "standard_test_update": "disabled"
  },
  "trigger": {
    "statistics_scope": "all_type_matched_retrieved_memories",
    "epsilon": 1e-12,
    "feature_formulas": {
      "R_debate": "sum(d_k)/(N_ret+epsilon)",
      "R_succ": "sum(d_k*f_k)/(sum(d_k)+epsilon)",
      "R_correct": "sum(d_k*(1-b_k)*f_k)/(sum(d_k)+epsilon)",
      "R_harm": "sum(d_k*b_k*(1-f_k))/(sum(d_k)+epsilon)",
      "R_quick": "sum(d_k*tau_k)/(sum(d_k)+epsilon)",
      "mean_similarity": "sum(sim_k)/(N_ret+epsilon)"
    },
    "theta_0": 0.65,
    "alpha": 0.25,
    "validation_correct_trigger_decisions": 63,
    "validation_decisions": 90,
    "validation_trigger_accuracy": 0.7,
    "theta_formula": "theta_0-alpha*(validation_trigger_accuracy-0.5)",
    "test_theta": 0.6,
    "comparison": "strict_greater_than",
    "rules": [
      {"priority": 1, "condition": "N_ret < 2", "decision": "debate", "confidence": 0.7},
      {"priority": 2, "condition": "R_succ > 0.80 and N_ret >= 3 and normalized_entropy < 0.80", "decision": "no_debate", "confidence": "R_succ"},
      {"priority": 3, "condition": "R_correct > 2*R_harm", "decision": "debate", "confidence": "min(1,R_correct-R_harm+0.50)"},
      {"priority": 4, "condition": "p_max < 0.40 or normalized_entropy > 0.80 or top_two_ratio < 1.50 or mean_similarity < 0.20 or D >= 0.60", "decision": "debate", "confidence": 0.65},
      {"priority": 5, "condition": "otherwise", "decision": "no_debate", "confidence": 0.5}
    ],
    "final_decision": "matched_decision == debate and confidence > test_theta"
  },
  "difficulty": {
    "formula": "0.4*(1-p_max)+0.3*normalized_entropy+0.2*(1-N_mem/5)+0.1*(question_length_words/100)",
    "weights": {"one_minus_p_max": 0.4, "normalized_entropy": 0.3, "memory_unavailability": 0.2, "question_length": 0.1},
    "memory_normalizer": 5,
    "question_length_normalizer_words": 100,
    "question_length_counting": "Unicode regex word tokens after whitespace normalization",
    "normalized_entropy": "-sum(p_j*log(p_j))/log(M)",
    "entropy_zero_term": "0*log(0)=0",
    "top_two_ratio": "p_max/max(p_second,1e-12)",
    "clip_components_and_final_score": [0.0, 1.0],
    "bands": {"low": "D < 0.30", "medium": "0.30 <= D < 0.60", "high": "D >= 0.60"}
  },
  "debate": {
    "base_rounds": {"low": 3, "medium": 5, "high": 8},
    "minimum_rounds": 2,
    "successful_case_threshold": 3,
    "round_reduction_beta": 1,
    "successful_case_count_definition": "N_succ is the number of cases satisfying correct == true and validity_score > 0.7 among the at-most-15 type-matched candidates scanned before truncation to the at-most-3 cases inserted into the prompt",
    "maximum_rounds_formula": "max(minimum_rounds,base_rounds-round_reduction_beta*I[N_succ>=successful_case_threshold])",
    "early_stop_stable_rounds": 2,
    "early_stop_signal": "unchanged_parsed_synthesizer_answer",
    "round_schedule": ["logical_agent", "innovative_agent", "synthesizer_agent"],
    "first_round_context": ["multimodal_background", "question", "options", "baseline_distribution", "up_to_three_high_validity_memories", "retrieval_pattern_summary"],
    "later_round_context": ["first_round_context", "complete_previous_debate_messages"],
    "answer_pattern": "Final Answer: [A-E]",
    "fallback": "majority_vote_over_last_valid_agent_answers",
    "fallback_tie_break": "alphabetical_option_order",
    "invalid_final_answer": "incorrect_and_retained_in_denominator"
  },
  "evaluation": {
    "standard_mode": "frozen_memory_offline",
    "test_label_access_before_prediction": false,
    "result_record_key": ["protocol_id", "run_id", "model_id", "method_id", "condition_id", "pass_index", "sensitivity_setting_id", "episode_id", "question_id"],
    "question_processing_order": ["episode_id_ascending", "question_id_ascending"],
    "output_format": "JSON Lines UTF-8",
    "failed_request_policy": "three_retries_then_INVALID_retained_in_denominator"
  }
}
