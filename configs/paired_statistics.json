{
  "schema_version": "1.0",
  "config_id": "muma-tom-paired-statistics-v1",
  "common": "common.json",
  "subset_id": "muma-tom-repeat550-v1",
  "questions": 550,
  "runs": 5,
  "run_id": "paired-statistics-v1",
  "prediction_aggregation": "majority_vote_per_question",
  "valid_labels": ["A", "B", "C", "D", "E"],
  "vote_tie_break": "alphabetical_option_order",
  "invalid_prediction": "incorrect_and_retained_in_denominator",
  "bootstrap": {"unit": "paired_question_id", "resamples": 5000, "confidence_level": 0.95, "interval": "percentile", "seed": 84726111},
  "mcnemar": {"continuity_correction": true, "formula": "(|n01-n10|-1)^2/(n01+n10)"},
  "multiple_comparisons": {"method": "Holm-Bonferroni", "family_size": 3, "comparisons": ["full_framework_vs_single_pass", "full_framework_vs_Shi_et_al", "full_framework_vs_debate_without_memory"]},
  "input_pattern": "outputs/repeated_runs/{method_id}/{run_id}.jsonl",
  "output_json": "outputs/repeated_runs/paired_statistics.json"
}
